{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_tool_state.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__astro__.*|mcp__open-meteo__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_tool_state.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 scripts/state.py:*)",
      "Bash(python3 .claude/skills/artifact-validator/check_artifact.py:*)",
      "mcp__astro__list_catalog",
      "mcp__astro__dark_window",
      "mcp__astro__moon_info",
      "mcp__astro__object_visibility",
      "mcp__open-meteo__geocoding",
      "mcp__open-meteo__weather_forecast",
      "mcp__open-meteo__elevation",
      "WebSearch",
      "WebFetch"
    ]
  },
  "enableAllProjectMcpServers": true
}
